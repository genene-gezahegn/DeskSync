# DeskSync production configuration
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# Generate a private secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_PRIVATE_SECRET_OF_AT_LEAST_32_CHARACTERS

# Frontend production URL
FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app

# Require administrator approval for bookings
REQUIRE_BOOKING_APPROVAL=true
